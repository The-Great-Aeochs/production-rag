# Generate separate random tokens/passwords. Never commit .env.
ENVIRONMENT=development
API_KEYS={"replace-with-a-random-token-of-at-least-32-characters":"default"}
ADMIN_API_KEY=replace-with-a-different-random-token-at-least-32-characters
PG_PASSWORD=replace-with-a-random-database-password
# Production example: PG_SSLMODE=verify-full and PG_SSLROOTCERT=/run/secrets/pg-ca.pem
QDRANT_API_KEY=replace-with-a-random-qdrant-api-key
REDIS_PASSWORD=replace-with-a-random-redis-password
# Keep this consistent with REDIS_PASSWORD; URL-encode reserved characters.
REDIS_URL=redis://:replace-with-a-random-redis-password@localhost:6379
QDRANT_URL=http://localhost:6333
OLLAMA_URL=http://localhost:11434

# Existing supported S3-compatible storage; these legacy variable names hold
# scoped service credentials, not necessarily server root credentials.
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=replace-with-object-store-access-key
MINIO_ROOT_PASSWORD=replace-with-object-store-secret-key
MINIO_BUCKET=raw-docs
MINIO_SECURE=false
# Use TLS for production S3; configure the worker's container endpoint if needed.
CONTAINER_S3_ENDPOINT=host.docker.internal:9000
# Optional self-hosting override: verified image@sha256:... (no default image).
# OBJECT_STORE_IMAGE=

INGEST_ROOT=./documents
CORPUS_ID=default
REQUESTS_PER_MINUTE=60
MAX_CONCURRENT_QUERIES=8
GENERATION_TIMEOUT_S=60
GENERATION_MAX_TOKENS=1024
# Full query/answer logging is off by default.
LOG_QUERY_CONTENT=false
# Optional eval judge; retrieval-only evaluation requires no paid API calls.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# Default model weights are pinned to verified Hugging Face commits in Settings.
# Override model AND its revision together when changing models.
