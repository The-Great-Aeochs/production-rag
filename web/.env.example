# Set Vercel's Root Directory to web. No privileged keys use NEXT_PUBLIC_.
# Empty credentials keep the showcase/guided examples working; protected areas fail closed.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_TEMPLATE=production-rag
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/workspace
RAG_API_URL=
# Match the backend DEMO_PROXY_SECRET. Never use ADMIN_API_KEY here.
DEMO_PROXY_SECRET=

# Canonical public site URL, including https://; Vercel URL is the fallback.
# SITE_URL=https://your-domain.example
