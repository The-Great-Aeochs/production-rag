# Copy to deploy/server.env (ignored). Never commit populated values.
# Example placeholders allow `docker compose config --quiet` in CI only.
API_DOMAIN=api.example.com
TLS_EMAIL=operator@example.com
RAG_IMAGE=production-rag:beta
ADMIN_API_KEY=replace-with-an-independent-64-character-hex-secret
PG_PASSWORD=replace-with-an-independent-64-character-hex-secret
REDIS_PASSWORD=replace-with-an-independent-64-character-hex-secret
QDRANT_API_KEY=replace-with-an-independent-64-character-hex-secret
JWT_ISSUER=https://your-instance.clerk.accounts.dev
JWT_AUTHORIZED_PARTIES=["https://production-rag-pi.vercel.app"]

# Supported external S3-compatible service; hostname only, without https://.
# Restrict these credentials to a private, precreated raw-docs bucket.
MINIO_ENDPOINT=your-s3-endpoint.example.com
MINIO_ROOT_USER=replace-with-scoped-access-key
MINIO_ROOT_PASSWORD=replace-with-scoped-secret-key
MINIO_BUCKET=raw-docs

# Downloaded from Ollama by the operator before launch. CPU latency is unmeasured.
OLLAMA_MODEL=hf.co/unsloth/Qwen3-8B-GGUF:UD-Q4_K_XL
DEMO_ENABLED=false
DEMO_PROXY_SECRET=
